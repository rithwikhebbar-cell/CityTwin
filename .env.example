# GEMINI_API_KEY: Required for server-side Gemini AI planning assistant calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Dedicated browser-accessible Google Maps JavaScript API key
# for Real-City exploration mode. Never put GEMINI_API_KEY here.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# VITE_APP_URL: Canonical public application URL for Supabase Auth email confirmation redirects.
# - For local development on same computer: leave empty or use http://localhost:3000
# - For mobile device testing on local network: set to your machine's LAN IP e.g. http://192.168.1.100:3000
#   (or a tunneling URL like ngrok/Cloudflare: https://xxxx.ngrok-free.app)
# - For production deployments: set to your public domain e.g. https://citytwin.yourdomain.com
# If omitted, CityTwin automatically defaults to the browser's window.location.origin.
VITE_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# VITE_SUPABASE_URL: Your Supabase project URL for PostgreSQL persistence.
# e.g. https://your-project-id.supabase.co (do NOT append /rest/v1)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Your Supabase public anonymous API key (safe for browser).
# Never put service_role or DB password here.
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
